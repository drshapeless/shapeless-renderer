    NORTH          :: 3;
    BACK           :: 4;
    GUIDE          :: 5;
    START          :: 6;
    LEFT_STICK     :: 7;
    RIGHT_STICK    :: 8;
    LEFT_SHOULDER  :: 9;
    RIGHT_SHOULDER :: 10;
