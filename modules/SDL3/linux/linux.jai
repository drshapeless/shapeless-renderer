    NINTENDO_SWITCH_JOYCON_LEFT  :: 8;
    NINTENDO_SWITCH_JOYCON_RIGHT :: 9;
    NINTENDO_SWITCH_JOYCON_PAIR  :: 10;
    COUNT                        :: 11;

