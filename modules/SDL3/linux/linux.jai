    destination: GPUBlitRegion;
    load_op:     GPULoadOp;
    clear_color: FColor;
    flip_mode:   FlipMode;
    filter:      GPUFilter;
    cycle:       bool;
    padding1:    Uint8;
    padding2:    Uint8;
    padding3:    Uint8;
}

GPUBufferBinding :: struct {
    buffer: *GPUBuffer;
    offset: Uint32;
}

GPUTextureSamplerBinding :: struct {
    texture: *GPUTexture;
